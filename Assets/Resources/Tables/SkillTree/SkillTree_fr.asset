  m_TableData:
  - m_Id: 63243012526612480
    m_Localized: "La distance parcourue par votre Dash passe de 4 \xE0 5."
    m_Metadata:
      m_Items: []
  - m_Id: 63242967551090688
    m_Localized: "La distance parcourue par votre Dash passe de 3 \xE0 4."
    m_Metadata:
      m_Items: []
  - m_Id: 1420572834439168
    m_Localized: ACHETER !
    m_Metadata:
      m_Items: []
  - m_Id: 1420870055403520
    m_Localized: "Activ\xE9 !"
    m_Metadata:
      m_Items: []
  - m_Id: 1420907695087616
    m_Localized: "D\xE9sactiv\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 3838578088779776
    m_Localized: Glissade Bleue
    m_Metadata:
      m_Items: []
  - m_Id: 3838632002363392
    m_Localized: "Votre curseur est bleu tant que vous glissez sur un mur et vous
      indique le temps que vous pouvez y rester accroch\xE9.\n\nCette dur\xE9e passe
      de 0.8s \xE0 1.3s."
    m_Metadata:
      m_Items: []
  - m_Id: 3843911402168320
    m_Localized: Overrides
    m_Metadata:
      m_Items: []
  - m_Id: 3843992423538688
    m_Localized: "Apr\xE8s \xEAtre all\xE9 suffisament loin dans un niveau, celui-ci
      sera alt\xE9r\xE9 avec un d\xE9fi suppl\xE9mentaire offrant une r\xE9compense
      pouvant multiplier vos Cr\xE9dits jusqu'\xE0 x100 !\n\nCe sont les Overrides
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 3847818635419648
    m_Localized: Portails
    m_Metadata:
      m_Items: []
  - m_Id: 3847855683706880
    m_Localized: "Tous les 10 Blocks se trouvera d\xE9sormais un Portail.\n\nTraverser
      un Portail augmente l'incr\xE9ment de toutes les Datas suivante de +1."
    m_Metadata:
      m_Items: []
  - m_Id: 3934610713780224
    m_Localized: "Atterrissage acc\xE9l\xE9r\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 3934648412184576
    m_Localized: "Appuyez sur {0} pour vous d\xE9crochez des murs lorsque vous glissez
      dessus.\n\nMaintenez {0} enfonc\xE9 au moment d'un atterrissage pour gagner
      30% de vitesse d\xE9gressive sur 1.2s."
    m_Metadata:
      m_Items:
      - id: 0
  - m_Id: 3934674291040256
    m_Localized: Atterrissage explosif
    m_Metadata:
      m_Items: []
  - m_Id: 3934693123465216
    m_Localized: "Le gain de vitesse passe \xE0 125% d\xE9gressif mais ne dure plus
      que 0.6s."
    m_Metadata:
      m_Items: []
  - m_Id: 7968019157131264
    m_Localized: Neon Dash
    m_Metadata:
      m_Items: []
  - m_Id: 7968050224340992
    m_Localized: "Dashez en appuyant sur {0} !\n\nVous r\xE9initialisez votre Dash
      \xE0 chaque fois que vous atterrissez au sol."
    m_Metadata:
      m_Items:
      - id: 0
  - m_Id: 7978318341906432
    m_Localized: "Dash r\xE9actif"
    m_Metadata:
      m_Items: []
  - m_Id: 7978355595714560
    m_Localized: "Vous r\xE9initialisez maintenant votre Dash tant que vous \xEAtes
      au sol, et plus seulement quand vous atterrissez."
    m_Metadata:
      m_Items: []
  - m_Id: 8327556129136640
    m_Localized: Recommencer()
    m_Metadata:
      m_Items: []
  - m_Id: 8356585150390272
    m_Localized: Nouveau Skill {0}
    m_Metadata:
      m_Items:
      - id: 0
  - m_Id: 20921864153767936
    m_Localized: "Saut de Pr\xE9cision"
    m_Metadata:
      m_Items: []
  - m_Id: 20921911218053120
    m_Localized: "Rel\xE2chez {0} au milieu d'un saut pour l'interrompre et effectuer
      un saut plus petit et plus pr\xE9cis.\n\nMaintenez jusqu'\xE0 la fin pour effectuer
      un saut de taille maximale comme pr\xE9c\xE9demment."
    m_Metadata:
      m_Items:
      - id: 0
  - m_Id: 20934641698250752
    m_Localized: Portails Quadratiques
    m_Metadata:
      m_Items: []
  - m_Id: 20934692625489920
    m_Localized: "Traverser un Portail augmente maintenant l'incr\xE9ment de toutes
      les Datas suivante de +2, puis +3, puis +4, etc."
    m_Metadata:
      m_Items: []
  - m_Id: 21419465999425536
    m_Localized: "Exploit \xC9piphanique"
    m_Metadata:
      m_Items: []
  - m_Id: 21419511037861888
    m_Localized: "Lorsque vous terminez un niveau pour la premi\xE8re fois en arrivant
      au 100i\xE8me Bloc, vous gagnez autant de Cr\xE9dits que n\xE9cessaire pour
      finir le niveau \xE0 100%."
    m_Metadata:
      m_Items: []
  - m_Id: 21586081940807680
    m_Localized: Boot Rapide
    m_Metadata:
      m_Items: []
  - m_Id: 21586145086054400
    m_Localized: Dual Boot
    m_Metadata:
      m_Items: []
  - m_Id: 21586202594156544
    m_Localized: Chrono Boot
    m_Metadata:
      m_Items: []
  - m_Id: 21586126610145280
    m_Localized: "Les 3 premiers Blocs de chaque niveau vous rapportent 3 fois plus
      de Cr\xE9dits."
    m_Metadata:
      m_Items: []
  - m_Id: 21586186710327296
    m_Localized: "Les 5 premiers Blocs de chaque niveau vous rapportent 5 fois plus
      de Cr\xE9dits \xE0 la place."
    m_Metadata:
      m_Items: []
  - m_Id: 21586240695214080
    m_Localized: "Les 10 premiers Blocs de chaque niveau vous rapportent 10 fois
      plus de Cr\xE9dits \xE0 la place."
    m_Metadata:
      m_Items: []
  - m_Id: 21673509380726784
    m_Localized: "Br\xE8che de Data"
    m_Metadata:
      m_Items: []
  - m_Id: 21673541433597952
    m_Localized: "Chaque Bloc a 33% de chance d'avoir une Data.\n\nR\xE9cup\xE9rer
      une Data augmente le nombre de Cr\xE9dits que vous gagnez \xE0 chaque Bloc
      suivant de +1."
    m_Metadata:
      m_Items: []
  - m_Id: 63243056994623488
    m_Localized: "La distance parcourue par votre Dash passe de 5 \xE0 6."
    m_Metadata:
      m_Items: []
  - m_Id: 63242919912185856
    m_Localized: Distance du Dash +1
    m_Metadata:
      m_Items: []
  - m_Id: 63242994889564160
    m_Localized: Distance du Dash +2
    m_Metadata:
      m_Items: []
  - m_Id: 63243033003204608
    m_Localized: Distance du Dash +3
    m_Metadata:
      m_Items: []
  - m_Id: 63243144613634048
    m_Localized: "Annule la pouss\xE9e des Cubes du Vide (et les autres pouss\xE9es)
      lorsque vous dashez."
    m_Metadata:
      m_Items: []
  - m_Id: 63243100644745216
    m_Localized: Dash Immuable
    m_Metadata:
      m_Items: []
  - m_Id: 63243199403827200
    m_Localized: Votre curseur vous indique si votre Dash est disponible ainsi que
      le nombre de charges qu'il vous reste.
    m_Metadata:
      m_Items: []
  - m_Id: 63243167774580736
    m_Localized: Indicateur du Dash
    m_Metadata:
      m_Items: []
  - m_Id: 63243217930067968
    m_Localized: Double Dash
    m_Metadata:
      m_Items: []
  - m_Id: 63243266646908928
    m_Localized: "Vous pouvez dasher une deuxi\xE8me fois avant de retourner au sol."
    m_Metadata:
      m_Items: []
  - m_Id: 63243286125256704
    m_Localized: Triple Dash
    m_Metadata:
      m_Items: []
  - m_Id: 63243301790982144
    m_Localized: "Vous pouvez dasher une troisi\xE8me fois avant de retourner au
      sol."
    m_Metadata:
      m_Items: []
  - m_Id: 63243323572002816
    m_Localized: "Dash R\xE9initialisation"
    m_Metadata:
      m_Items: []
  - m_Id: 63243387891654656
    m_Localized: "Vous r\xE9initialisez votre accrochage au mur lorsque vous dashez.\nCe
      qui vous permet de vous accrocher de nouveau au m\xEAme mur."
    m_Metadata:
      m_Items: []
  - m_Id: 63256923036491776
